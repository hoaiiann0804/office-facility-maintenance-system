# ==============================================================================
# SELF-HOST PRODUCTION ENVIRONMENT (.env.selfhost)
# Copy file nay thanh ".env.selfhost" va dien gia tri that (KHONG commit len Git!)
# ==============================================================================

# Tag image theo Git SHA (deploy-selfhost.ps1 tu dong gan bien nay)
IMM_IMAGE_TAG=latest

# Thu muc backup SQL Server nam NGOAI o D (duoc mount vao container)
BACKUP_DIR=C:/ImmBackups

# ==============================================================================
# SQL SERVER (khong dung tai khoan sa cho app!)
# ==============================================================================
MSSQL_SA_PASSWORD=Thay_Bang_Mat_Khau_SA_Manh_It_Nhat_16_Ky_Tu!
APP_DB_USER=imm_app
APP_DB_PASSWORD=Thay_Bang_Mat_Khau_App_User_Rieng_16_Ky_Tu!

# App ket noi qua user rieng (imm_app), KHONG dung sa
ConnectionStrings__DefaultConnection=Server=sqlserver-selfhost,1433;Database=InternalMaintenanceDb;User Id=imm_app;Password=Thay_Bang_Mat_Khau_App_User_Rieng_16_Ky_Tu!;TrustServerCertificate=True;Encrypt=False

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
Jwt__Key=Thay_Bang_Chuoi_Bi_Mat_Ngau_Nhien_It_Nhat_32_Ky_Tu
Jwt__Issuer=InternalMaintenanceApi
Jwt__Audience=InternalMaintenanceClient
Jwt__ExpiresInMinutes=60
Jwt__RefreshTokenExpiresInDays=7

# ==============================================================================
# CORS & DEMO MODE
# ==============================================================================
Cors__AllowedOrigins__0=https://maintenance.shopmini.io.vn
DemoMode__Enabled=true

# ==============================================================================
# EMAIL (RESEND HTTP API)
# ==============================================================================
Resend__ApiKey=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
Resend__FromEmail=no-reply@mail.shopmini.io.vn
Resend__FromName=Maintenance System

# ==============================================================================
# CLOUDFLARE R2 OBJECT STORAGE
# ==============================================================================
R2__AccountId=your_cloudflare_account_id
R2__BucketName=internal-maintenance-attachments
R2__AccessKeyId=your_r2_access_key_id
R2__SecretAccessKey=your_r2_secret_access_key
R2__Endpoint=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2__Region=auto
R2__PresignExpiresMinutes=15

# ==============================================================================
# GOOGLE SSO & FRONTEND BUILD ARGS
# ==============================================================================
Google__ClientId=your_google_client_id.apps.googleusercontent.com
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_ENABLE_DEMO_MODE=true

